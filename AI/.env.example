# AmanGuard AI engine (phishingGPT.py) — required environment variables.
# Copy to AI/.env for local dev. NEVER commit AI/.env (it is gitignored).
# On Railway these are set in the service's Variables tab, not in a file.

# OpenAI key the engine calls on every analysis. Without it the engine returns
# its cautious fallback and the backend drops to rule-based scoring.
OPENAI_API_KEY=

# Shared secret the backend must present as "Authorization: Bearer <value>".
# MUST equal the backend's AI_API_KEY. Leave BLANK for local dev (service stays
# open, so the browser extension's direct 127.0.0.1:8000 calls keep working).
# REQUIRED in any deployed environment — without it the endpoint is unauthenticated
# and anyone who reaches it spends your OpenAI credits.
AI_SERVICE_KEY=

# Injected by Railway. Locally the engine defaults to 8000.
PORT=
