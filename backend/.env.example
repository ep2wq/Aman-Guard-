# AmanGuard Spring Boot backend — required environment variables.
# Local dev needs NONE of these: application.yaml carries working defaults for
# a local MySQL. These are what you paste into Railway's Variables tab.
# NEVER commit real values.

# ── Database ────────────────────────────────────────────────────────────────
# On Railway, reference the MySQL plugin's variables rather than pasting
# literals, e.g.
#   SPRING_DATASOURCE_URL=jdbc:mysql://${{MySQL.MYSQLHOST}}:${{MySQL.MYSQLPORT}}/${{MySQL.MYSQLDATABASE}}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# ── Auth ────────────────────────────────────────────────────────────────────
# HS256 signing secret. Generate with: openssl rand -base64 48
# The application.yaml default is a PUBLIC demo value — override it anywhere real.
AMANGUARD_JWT_SECRET=

# ── AI engine ───────────────────────────────────────────────────────────────
# Railway private network (IPv6, no public domain):
#   AI_ENGINE_URL=http://ai-engine.railway.internal:8000
AI_ENGINE_URL=

# Shared secret sent to the AI engine as "Authorization: Bearer <value>".
# MUST equal the AI service's AI_SERVICE_KEY. Blank = no header sent (local dev).
AI_API_KEY=

# ── Server ──────────────────────────────────────────────────────────────────
# Injected by Railway; the app must listen on it. Defaults to 8080 locally.
PORT=
